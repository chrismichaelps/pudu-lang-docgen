/// Runs every export format contract.
fn main() -> Int {
  let json = Export.files(&units(), "json")
  let checks = Test.suite("Api export", &[
      Test.equals("json paths", &json.map(fn(entry: (Str, Str)) -> Str {
            let (path, _text) = entry
            path
          }), &["M.json", "N.json", "toc.yml"]),
      Test.that("json model decodes", match Json.decode(written("json", "M.json")) { case Ok(found) => Json.encode(&found).contains("\"uid\":\"M.T.go\"") case Err(_) => false }),
      Test.equals("json toc links json files", &written("json", "toc.yml"), &"- name: M\n  href: M.json\n  items:\n  - name: R\n    href: M.R.json\n  - name: T\n    href: M.T.json\n  - name: U\n    href: M.U.json\n- name: N\n  href: N.json\n  items:\n  - name: E\n    href: N.E.json\n"),
      Test.equals("markdown paths", &Export.files(&units(), "markdown").length(), &7),
      Test.equals("formats", &Export.FORMATS, &["json", "markdown", "apiPage"]),
      Test.equals("markdown M.md", &written("markdown", "M.md"), &expectedMarkdownMMd()),
      Test.equals("markdown M.R.md", &written("markdown", "M.R.md"), &expectedMarkdownMRMd()),
      Test.equals("markdown M.U.md", &written("markdown", "M.U.md"), &expectedMarkdownMUMd()),
      Test.equals("markdown M.T.md", &written("markdown", "M.T.md"), &expectedMarkdownMTMd()),
      Test.equals("markdown N.md", &written("markdown", "N.md"), &expectedMarkdownNMd()),
      Test.equals("markdown N.E.md", &written("markdown", "N.E.md"), &expectedMarkdownNEMd()),
      Test.equals("markdown toc.yml", &written("markdown", "toc.yml"), &expectedMarkdownTocYml()),
      Test.equals("apiPage M.yml", &written("apiPage", "M.yml"), &expectedApipageMYml()),
      Test.equals("apiPage M.R.yml", &written("apiPage", "M.R.yml"), &expectedApipageMRYml()),
      Test.equals("apiPage M.U.yml", &written("apiPage", "M.U.yml"), &expectedApipageMUYml()),
      Test.equals("apiPage M.T.yml", &written("apiPage", "M.T.yml"), &expectedApipageMTYml()),
      Test.equals("apiPage N.yml", &written("apiPage", "N.yml"), &expectedApipageNYml()),
      Test.equals("apiPage N.E.yml", &written("apiPage", "N.E.yml"), &expectedApipageNEYml())
    ])
  let ran = Test.run(&checks)
  for failure in Test.failuresOf(&ran) { let _printed = Io.writeErrorLine(failure) }
  Test.report(&ran)
}
