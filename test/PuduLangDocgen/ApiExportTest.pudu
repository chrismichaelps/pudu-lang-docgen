/** @Docgen.Api.ExportTests — extracted declarations round out as model, Markdown, and API pages */
module PuduLangDocgen.ApiExportTest

import Std.Io as Io
import Std.Json as Json
import Std.Test as Test
import PuduLangDocgen.Api.Export as Export
import PuduLangDocgen.Api.Model as Model
import PuduLangDocgen.Api.Parser as Parser

/// A module with a documented record, an undocumented union, a trait, a function, and a constant.
const SOURCE: Str = "/** @M.Module — mod doc */\nmodule M\n\n/// A rec.\nexport type R = \{\n  /// Field a.\n  a: Int\n\}\n\nexport type U = A | B\n\n/// Tr.\nexport trait T \{\n  /// Go.\n  fn go(self: &Self, n: Int) -> Int\n\}\n\n/// Adds.\nexport fn add(a: Int) -> Int \{ a \}\n\nexport const K: Int = 1\n"

/// A module without documentation holding one empty record.
const BARE: Str = "module N\n\nexport type E = \{\}\n"

/// Both modules as parsed.
fn units() -> Array[Model.Unit] { [Parser.parse("src/M.pudu", SOURCE), Parser.parse("src/N.pudu", BARE)] }

/// The text written at a path in a format, or a marker when nothing is.
fn written(format: Str, path: Str) -> Str {
  for (found, text) in Export.files(&units(), format) {
    if found == path { return text }
  }
  "missing " + path
}

/// Expected markdown output for `M.md`.
fn expectedMarkdownMMd() -> Str {
  [
    "---",
    "uid: M",
    "title: M",
    "---",
    "",
    "# M",
    "",
    "Mod doc",
    "",
    "- <xref:M.R>: A rec.",
    "- <xref:M.U>",
    "- <xref:M.T>: Tr.",
    "",
    "## add \{#add\}",
    "",
    "```pudu",
    "fn add(a: Int) -> Int",
    "```",
    "",
    "Adds.",
    "",
    "## K \{#K\}",
    "",
    "```pudu",
    "const K: Int = 1",
    "```",
    "",
    ""
  ].join("\n")
}

