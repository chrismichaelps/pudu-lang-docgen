    "- name: M",
    "  href: M.md",
    "  items:",
    "  - name: R",
    "    href: M.R.md",
    "  - name: T",
    "    href: M.T.md",
    "  - name: U",
    "    href: M.U.md",
    "- name: N",
    "  href: N.md",
    "  items:",
    "  - name: E",
    "    href: N.E.md",
    ""
  ].join("\n")
}

/// Expected apiPage output for `M.yml`.
fn expectedApipageMYml() -> Str {
  [
    "#YamlMime:ApiPage",
    "title: M",
    "languageId: pudu",
    "body:",
    "- h1: M",
    "- markdown: Mod doc",
    "- h2: Types",
    "- list:",
    "  - text: R",
    "    url: M.R.html",
    "  - text: U",
    "    url: M.U.html",
    "  - text: T",
    "    url: M.T.html",
    "- api3: add",
    "  id: add",
    "- code: \"fn add(a: Int) -> Int\"",
    "- markdown: Adds.",
    "- parameters:",
    "  - name: a",
    "    type: Int",
    "- api3: K",
    "  id: K",
    "- code: \"const K: Int = 1\"",
    ""
  ].join("\n")
}

