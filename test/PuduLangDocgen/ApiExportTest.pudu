    "# R",
    "",
    "Module <xref:M>",
    "",
    "```pudu",
    "type R = \{ a: Int \}",
    "```",
    "",
    "A rec.",
    "",
    "| Name | Type | Description |",
    "| --- | --- | --- |",
    "| `a` | `Int` | Field a. |",
    ""
  ].join("\n")
}

