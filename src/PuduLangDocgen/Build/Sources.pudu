/** @Docgen.Build.Sources — project files mapped to outputs and read into typed documents */
module PuduLangDocgen.Build.Sources

import Std.Glob as Glob
import Std.Json as Json
import Std.List as List
import Std.Map as Map
import PuduLangDocgen.Configuration as Configuration
import PuduLangDocgen.Constants.Codes as Codes
import PuduLangDocgen as Docgen
import PuduLangDocgen.Markdown as Markdown
import PuduLangDocgen.Meta as Meta
import PuduLangDocgen.Navigation as Navigation
import PuduLangDocgen.Paths as Paths
import PuduLangDocgen.Rest.OpenApi as OpenApi
import PuduLangDocgen.Site.Gallery as Gallery
import PuduLangDocgen.Yaml as Yaml

/** @Docgen.Build.Document — one content file read into the form its kind needs */
export type Document = Article(Markdown.Article) | Service(OpenApi.Service) | ApiPage(Docgen.Meta) | Catalog(Docgen.Meta) | Moved(Str)

/** @Docgen.Build.Entry — a content file, where it publishes, and its merged metadata */
export type Entry = { source: Str, output: Str, meta: Array[(Str, Docgen.Meta)], document: Document }

/** @Docgen.Build.Read — every content file read, with tables of contents apart */
export type Read = { entries: Array[Entry], tocs: Array[(Str, Str, Navigation.Toc)], diagnostics: Array[Docgen.Diagnostic] }

/// Marker on the first line of a structured API page file.
const API_PAGE: Str = "#YamlMime:ApiPage"

/// Project files selected by mappings, each paired with its output path. A file matches when
/// it lies under the mapping's source folder, a `files` glob matches its path inside that
/// folder, and no `exclude` glob does. The output keeps that inner path under `dest`. Files
/// under `skip` folders are never selected; the first mapping to select a file wins.
export fn mapped(mappings: &Array[Configuration.Mapping], paths: &Array[Str], skip: &Array[Str]) -> Array[(Str, Str)] {
  selected(mappings, paths, skip).map(fn(entry: (Str, Str, Array[(Str, Docgen.Meta)])) -> (Str, Str) {
      let (source, output, _meta) = entry
      (source, output)
    })
}

/// Metadata that the group of a file's mapping gives it, by source path.
export fn groupMeta(mappings: &Array[Configuration.Mapping], paths: &Array[Str], skip: &Array[Str]) -> Map[Str, Array[(Str, Docgen.Meta)]] {
  mapOf(selected(mappings, paths, skip).map(fn(entry: (Str, Str, Array[(Str, Docgen.Meta)])) -> (Str, Array[(Str, Docgen.Meta)]) {
        let (source, _output, meta) = entry
        (source, meta)
      }))
}

/// Selected files with their outputs and group metadata.
fn selected(mappings: &Array[Configuration.Mapping], paths: &Array[Str], skip: &Array[Str]) -> Array[(Str, Str, Array[(Str, Docgen.Meta)])] {
  var result: Array[(Str, Str, Array[(Str, Docgen.Meta)])] = []
  var taken: Array[Str] = []
  for mapping in *mappings {
    for path in List.sorted(paths) {
      if taken.contains(path) || skip.filter(|folder: Str| path.startsWith(folder + "/")).length() > 0 { continue }
      let inner = if mapping.src.isEmpty() { path } else if path.startsWith(mapping.src + "/") { path.drop(mapping.src.length() + 1) } else { "" }
      if inner.isEmpty() || !Glob.matchesAny(&mapping.files, inner) || Glob.matchesAny(&mapping.exclude, inner) { continue }
      result = result.push((path, if mapping.dest.isEmpty() { inner } else { mapping.dest + "/" + inner }, mapping.meta))
      taken = taken.push(path)
    }
  }
  result
}

/// Global metadata and file metadata rules from the configuration and the metadata files it
/// names; later files override earlier values.
export fn metadata(config: &Configuration.Config, files: &Map[Str, Str]) -> (Array[(Str, Docgen.Meta)], Array[Meta.Rule], Array[Docgen.Diagnostic]) {
  var global = config.globalMetadata
  var rules = config.fileMetadata
  var problems: Array[Docgen.Diagnostic] = []
  for path in config.globalMetadataFiles {
    match object(path, files) {
      case Ok(fields) => { global = Meta.merge(&global, &fields) }
      case Err(problem) => { problems = problems.push(problem) }
    }
  }
  for path in config.fileMetadataFiles {
    match object(path, files) {
      case Ok(fields) => match Meta.rulesOf(&fields) {
        case Ok(found) => { rules = rules.concat(found) }
        case Err(reason) => { problems = problems.push(Docgen.error(Codes.CONFIG_INVALID, path, 1, reason)) }
      }
      case Err(problem) => { problems = problems.push(problem) }
    }
  }
  (Meta.merge(&global, &config.globalMetadata), rules, problems)
}

/// Content files read by kind: Markdown articles and redirects, HTTP interface descriptions,
/// structured API pages, and tables of contents. Metadata merges global values, then file
/// metadata of the file's group, then file rules, then the file's own header, which wins.
export fn read(content: &Array[(Str, Str)], files: &Map[Str, Str], global: &Array[(Str, Docgen.Meta)], rules: &Array[Meta.Rule], alerts: &Array[Str], groups: &Map[Str, Array[(Str, Docgen.Meta)]]) -> Read {
  var entries: Array[Entry] = []
  var tocs: Array[(Str, Str, Navigation.Toc)] = []
  var problems: Array[Docgen.Diagnostic] = []
  for (source, output) in *content {
    let text = match Map.get(files, source) {
      case Some(found) => found
      case None => {
        problems = problems.push(Docgen.error(Codes.CONTENT_UNREADABLE, source, 1, "content file could not be read"))
        continue
      }
    }
    let inherited = Meta.merge(&Meta.merge(global, &Map.getOr(groups, source, [])), &Meta.forPath(rules, source))
    let lowered = source.toLower()
    if Navigation.isToc(source) {
      match Navigation.parse(source, text) {
        case Ok(found) => { tocs = tocs.push((source, output, Navigation.Toc{..found, meta: Meta.merge(&Meta.merge(global, &found.meta), &Meta.forPath(rules, source))})) }
        case Err(found) => { problems = problems.concat(found) }
      }
    } else if lowered.endsWith(".md") || lowered.endsWith(".markdown") {
      let article = Markdown.parse(source, text, files, alerts)
      problems = problems.concat(article.diagnostics)
      let meta = Meta.merge(&inherited, &article.meta)
      let target = Meta.textOr(&meta, "redirect_url", "")
      let document = if target.isEmpty() { Article(article) } else { Moved(target) }
      entries = entries.push(Entry{source: source, output: Paths.output(output), meta: meta, document: document})
    } else if lowered.endsWith(".yml") || lowered.endsWith(".yaml") || lowered.endsWith(".json") {
      match structured(source, text) {
        case Ok(value) => {
          if text.split("\n")[0].contains(Gallery.MARKER) {
            entries = entries.push(Entry{source: source, output: Paths.output(output), meta: inherited, document: Catalog(value)})
          } else if text.trim().startsWith(API_PAGE) {
            entries = entries.push(Entry{source: source, output: Paths.output(output), meta: inherited, document: ApiPage(value)})
          } else if OpenApi.recognizes(&value) {
            match OpenApi.read(&value) {
              case Ok(service) => { entries = entries.push(Entry{source: source, output: Paths.output(output), meta: inherited, document: Service(service)}) }
              case Err(reason) => { problems = problems.push(Docgen.error(Codes.CONTENT_INVALID, source, 1, reason)) }
            }
          } else { problems = problems.push(Docgen.warning(Codes.CONTENT_UNSUPPORTED, source, 1, "structured file is not an interface description, an API page, or a catalog and is skipped")) }
        }
        case Err(reason) => { problems = problems.push(Docgen.error(Codes.CONTENT_INVALID, source, 1, reason)) }
      }
    } else { problems = problems.push(Docgen.warning(Codes.CONTENT_UNSUPPORTED, source, 1, "content file type is not supported; list it as a resource to copy it")) }
  }
  Read{entries: entries, tocs: tocs, diagnostics: problems}
}

/// A JSON or YAML file decoded by its extension.
fn structured(source: Str, text: Str) -> Result[Docgen.Meta, Str] {
  if source.toLower().endsWith(".json") {
    match Json.decode(text) {
      case Ok(found) => Ok(Meta.fromJson(&found))
      case Err(problem) => Err("not valid JSON: " + Json.explain(&problem))
    }
  } else {
    let decoded = Yaml.decode(text)
    match decoded {
      case Ok(found) => Ok(found)
      case Err(reason) => Err("not valid YAML: " + reason)
    }
  }
}

/// The object a metadata file holds.
fn object(path: Str, files: &Map[Str, Str]) -> Result[Array[(Str, Docgen.Meta)], Docgen.Diagnostic] {
  let text = match Map.get(files, path) {
    case Some(found) => found
    case None => { return Err(Docgen.error(Codes.CONFIG_UNREADABLE, path, 1, "metadata file could not be read")) }
  }
  match structured(path, text) {
    case Ok(Docgen.Fields(fields)) => Ok(fields)
    case Ok(_) => Err(Docgen.error(Codes.CONFIG_INVALID, path, 1, "metadata file must hold an object"))
    case Err(reason) => Err(Docgen.error(Codes.CONFIG_UNREADABLE, path, 1, reason))
  }
}
