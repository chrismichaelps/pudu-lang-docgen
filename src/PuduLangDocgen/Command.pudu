/** @Docgen.Command.Seam — the command line: build, metadata, serve, help, and version */
module PuduLangDocgen.Command

import Std.Concurrent as Concurrent
import Std.Io as Io
import Std.Path as Path
import PuduLangDocgen.Build as Build
import PuduLangDocgen.Constants.Package as Package
import PuduLangDocgen as Docgen
import PuduLangDocgen.Docset as Docset
import PuduLangDocgen.Docset.Tasks as Tasks
import PuduLangDocgen.Scaffold as Scaffold
import PuduLangDocgen.Serve as Serve

/** @Docgen.Command.Parsed — a command, its positional arguments, and its options */
export type Parsed = { command: Str, positional: Array[Str], flags: Array[Str], values: Array[(Str, Str)] }

/// Options that take a value.
const VALUED: Array[Str] = ["--output", "-o", "--metadata", "-m", "--xref", "-x", "--template", "-t", "--port", "-p", "--hostname", "-n"]

/// Options that stand alone.
const FLAGS: Array[Str] = ["--force", "--dryRun", "--warningsAsErrors", "--disableGitFeatures", "--exportRawModel", "--exportViewModel", "--serve", "-s", "--watch", "-w", "--yes", "-y", "--all", "-a", "--help", "-h"]

/// Command words.
const COMMAND_WORDS: Array[Str] = ["build", "metadata", "serve", "init", "pdf", "download", "merge", "template", "version", "help"]

/// Milliseconds between checks for changed sources while watching.
const WATCH_MILLIS: Int = 1000

/// Commands and what they do, for help text.
const COMMANDS: Array[(Str, Str)] = [
  ("[config]", "Build the site, API reference included (the default)"),
  ("build [config]", "The same as the default"),
  ("metadata [config]", "Write API metadata files for the configured sources"),
  ("serve [folder]", "Preview a built site over HTTP"),
  ("init [folder]", "Create a new documentation project"),
  ("pdf [config]", "Build the site and a PDF for every table of contents that sets pdf"),
  ("download <file> --xref <address>", "Save a cross-reference map from the web"),
  ("merge <maps...> -o <file>", "Combine cross-reference maps into one"),
  ("template list | export [folder]", "List the built-in templates or copy one for customizing"),
  ("version", "Print the package version"),
  ("help", "Print this help")
]

/// Default port of the preview server.
const PORT: Int = 8080

/// Runs a command line and answers its exit status: 0 success, 1 failed work, 2 invalid usage.
export fn run(arguments: &Array[Str]) -> Int {
  let parsed = match parse(arguments) {
    case Ok(found) => found
    case Err(reason) => {
      let _said = Io.writeErrorLine(reason + "\n\n" + usage())
      return 2
    }
  }
  if parsed.flags.contains("--help") || parsed.flags.contains("-h") || parsed.command == "help" {
    let _said = Io.writeLine(usage())
    return 0
  }
  if parsed.command == "version" {
    let _said = Io.writeLine(Package.NAME + " " + Package.VERSION)
    return 0
  }
  if parsed.command == "serve" { return serve(if parsed.positional.isEmpty() { "_site" } else { parsed.positional[0] }, &parsed, "") }
  if parsed.command == "init" { return initialize(&parsed) }
  if parsed.command == "template" { return template(&parsed) }
  if parsed.command == "download" { return download(&parsed) }
  if parsed.command == "merge" { return merge(&parsed) }
  let config = if parsed.positional.isEmpty() { Package.CONFIG_FILE } else { configPath(parsed.positional[0]) }
  let chosen = match options(&parsed) {
    case Ok(found) => found
    case Err(reason) => {
      let _said = Io.writeErrorLine(reason)
      return 2
    }
  }
  if parsed.command == "pdf" {
    return match Docset.pdf(config, &chosen) {
      case Ok(produced) => {
        for path in produced { let _said = Io.writeLine("wrote " + path) }
        0
      }
      case Err(problems) => failed(&problems)
    }
  }
  if parsed.command == "metadata" {
    return match Docset.metadata(config, &chosen) {
      case Ok(written) => {
        for path in written { let _said = Io.writeLine("wrote " + path) }
        0
      }
      case Err(problems) => failed(&problems)
    }
  }
  match Docset.build(config, &chosen, &Build.extensions()) {
    case Ok(report) => {
      for problem in report.diagnostics { let _said = Io.writeErrorLine(Docgen.describe(&problem)) }
      let _said = Io.writeLine("Build succeeded: " + show(report.written.length()) + " written, " + show(report.unchanged.length()) + " unchanged, " + show(report.removed.length()) + " removed.")
      if parsed.flags.contains("--serve") || parsed.flags.contains("-s") {
        let folder = Path.join(Path.directoryOf(config), if chosen.output.isEmpty() { "_site" } else { chosen.output })
        return serve(folder, &parsed, config)
      }
      0
    }
    case Err(problems) => failed(&problems)
  }
}

/// Command-line arguments read into a command, positional arguments, and options.
export fn parse(arguments: &Array[Str]) -> Result[Parsed, Str] {
  var parsed = Parsed{command: "", positional: [], flags: [], values: []}
  var index = 0
  if !arguments.isEmpty() && COMMAND_WORDS.contains(arguments[0]) {
    parsed = Parsed{..parsed, command: arguments[0]}
    index = 1
  }
  while index < arguments.length() {
    let argument = arguments[index]
    if VALUED.contains(argument) {
      if index + 1 >= arguments.length() { return Err("option " + argument + " needs a value") }
      parsed = Parsed{..parsed, values: parsed.values.push((canonical(argument), arguments[index + 1]))}
      index = index + 2
    } else if FLAGS.contains(argument) {
      parsed = Parsed{..parsed, flags: parsed.flags.push(argument)}
      index = index + 1
    } else if argument.startsWith("-") {
      return Err("unknown option " + argument)
    } else {
      parsed = Parsed{..parsed, positional: parsed.positional.push(argument)}
      index = index + 1
    }
  }
  let most = if parsed.command == "merge" { 1000 } else if parsed.command == "template" { 2 } else { 1 }
  if parsed.positional.length() > most { return Err("expected at most " + show(most) + " path" + (if most == 1 { "" } else { "s" }) + ", found " + parsed.positional.join(" ")) }
  Ok(parsed)
}

/// Help text listing commands and options.
export fn usage() -> Str {
  var lines = ["Usage: docgen [command] [path] [options]", "", "Commands:"]
  for (name, description) in COMMANDS { lines = lines.push("  " + name + "  " + description) }
  lines.concat([
      "", "Options:",
      "  -o, --output <folder>        Output folder instead of the configured one",
      "  -m, --metadata <key=value>   Global metadata; text, or true/false",
      "  -x, --xref <map>             Another cross-reference map address or path",
      "  -t, --template <folder>      Another template folder",
      "  --force                      Rewrite every output file",
      "  --dryRun                     Validate and plan without writing",
      "  --warningsAsErrors           Fail the build on any warning",
      "  --disableGitFeatures         Skip dates and edit links from git",
      "  --exportRawModel             Write each page's data model beside it",
      "  --exportViewModel            Write each page's view model beside it",
      "  -s, --serve                  Preview the site after building",
      "  -w, --watch                  Rebuild while serving when sources change",
      "  -y, --yes                    Accept every default when creating a project",
      "  -n, --hostname <host>        Preview host (localhost)",
      "  -p, --port <number>          Preview port (8080)",
      "  -h, --help                   Print this help"
    ]).join("\n")
}

/// Docset options from parsed arguments.
fn options(parsed: &Parsed) -> Result[Docset.Options, Str] {
  var chosen = Docset.options()
  for (name, value) in parsed.values {
    if name == "--output" { chosen = Docset.Options{..chosen, output: value} }
    if name == "--xref" { chosen = Docset.Options{..chosen, xref: chosen.xref.push(value)} }
    if name == "--template" { chosen = Docset.Options{..chosen, templates: chosen.templates.push(value)} }
    if name == "--metadata" {
      let at = value.indexOf("=")
      if at < 1 { return Err("metadata must be written key=value: " + value) }
      let written = value.drop(at + 1)
      let held = if written == "true" { Docgen.Flag(true) } else if written == "false" { Docgen.Flag(false) } else { Docgen.Text(written) }
      chosen = Docset.Options{..chosen, metadata: chosen.metadata.push((value.take(at), held))}
    }
  }
  Ok(Docset.Options{..chosen,
      force: parsed.flags.contains("--force"), dryRun: parsed.flags.contains("--dryRun"), warningsAsErrors: parsed.flags.contains("--warningsAsErrors"),
      disableGitFeatures: parsed.flags.contains("--disableGitFeatures"), exportRawModel: parsed.flags.contains("--exportRawModel"),
      exportViewModel: parsed.flags.contains("--exportViewModel") })
}

/// The long name of an option.
fn canonical(name: Str) -> Str {
  if name == "-o" { "--output" } else if name == "-m" { "--metadata" } else if name == "-x" { "--xref" } else if name == "-t" { "--template" } else if name == "-p" { "--port" } else if name == "-n" { "--hostname" } else { name }
}

/// A configuration path; a folder names its `docgen.json`.
fn configPath(written: Str) -> Str {
  if written.endsWith(".json") || written.endsWith(".yml") || written.endsWith(".yaml") { written } else { Path.join(written, Package.CONFIG_FILE) }
}

/// Serves a folder with the host and port options, answering an exit status. With `--watch`
/// and a configuration, the site is rebuilt whenever a source changes.
fn serve(folder: Str, parsed: &Parsed, config: Str) -> Int {
  var host = "localhost"
  var port = PORT
  for (name, value) in parsed.values {
    if name == "--hostname" { host = value }
    if name == "--port" {
      match value.toInt() {
        case Some(found) => { port = found }
        case None => {
          let _said = Io.writeErrorLine("port must be a number: " + value)
          return 2
        }
      }
    }
  }
  if !config.isEmpty() && (parsed.flags.contains("--watch") || parsed.flags.contains("-w")) {
    let chosen = match options(parsed) {
      case Ok(found) => found
      case Err(_) => Docset.options()
    }
    let output = if chosen.output.isEmpty() { "_site" } else { chosen.output }
    let started = Concurrent.start(fn() -> () {
        var seen = Docset.fingerprint(config, output)
        while true {
          let _paused = Concurrent.sleep(WATCH_MILLIS)
          let current = Docset.fingerprint(config, output)
          if current != seen {
            seen = current
            match Docset.build(config, &chosen, &Build.extensions()) {
              case Ok(report) => { let _said = Io.writeLine("Rebuilt: " + show(report.written.length()) + " written, " + show(report.removed.length()) + " removed.") }
              case Err(problems) => { for problem in problems { let _said = Io.writeErrorLine(Docgen.describe(&problem)) } }
            }
          }
        }
      })
    match started {
      case Ok(_) => { let _said = Io.writeLine("Watching " + config + " for changes") }
      case Err(_) => { let _said = Io.writeErrorLine("cannot watch for changes; serving without rebuilding") }
    }
  }
  match Serve.serve(folder, host, port) {
    case Ok(_) => 0
    case Err(reason) => {
      let _said = Io.writeErrorLine("cannot serve " + folder + ": " + reason)
      1
    }
  }
}

/// Reports failures and answers the failed-work status.
fn failed(problems: &Array[Docgen.Diagnostic]) -> Int {
  for problem in *problems { let _said = Io.writeErrorLine(Docgen.describe(&problem)) }
  let errors = problems.filter(|problem: Docgen.Diagnostic| problem.severity == Docgen.Error).length()
  let _summary = Io.writeErrorLine("Failed with " + show(errors) + " error(s) and " + show(problems.length() - errors) + " warning(s).")
  1
}

/// Creates a project, asking for a title and API sources unless `--yes` accepts defaults.
fn initialize(parsed: &Parsed) -> Int {
  let folder = if parsed.positional.isEmpty() { "." } else { parsed.positional[0] }
  let name = Path.nameOf(if folder == "." { Path.directoryOf(Path.join(folder, "x")) } else { folder })
  var answers = Scaffold.defaults(name)
  if !parsed.flags.contains("--yes") && !parsed.flags.contains("-y") {
    answers = Scaffold.Answers{..answers, title: ask("Site title", answers.title)}
    let api = ask("Document Pudu sources (yes/no)", "yes")
    answers = Scaffold.Answers{..answers, api: api.toLower().startsWith("y")}
    if answers.api { answers = Scaffold.Answers{..answers, sources: ask("Source folder", answers.sources)} }
    answers = Scaffold.Answers{..answers, pdf: ask("Enable PDF (yes/no)", "no").toLower().startsWith("y")}
  }
  match Tasks.init(folder, &answers) {
    case Ok(written) => {
      for path in written { let _said = Io.writeLine("created " + path) }
      let _next = Io.writeLine("Run: docgen " + (if folder == "." { "" } else { folder + " " }) + "--serve")
      0
    }
    case Err(problems) => failed(&problems)
  }
}

/// An answer read from the console, or the default for an empty line.
fn ask(question: Str, fallback: Str) -> Str {
  let _asked = Io.writeLine(question + " [" + fallback + "]: ")
  match Io.readLineOrEnd() {
    case Ok(Some(line)) => if line.trim().isEmpty() { fallback } else { line.trim() }
    case _ => fallback
  }
}

/// Lists built-in templates or exports the default one into a folder.
fn template(parsed: &Parsed) -> Int {
  let action = if parsed.positional.isEmpty() { "list" } else { parsed.positional[0] }
  if action == "list" {
    let _said = Io.writeLine("default\nmodern")
    return 0
  }
  if action != "export" {
    let _said = Io.writeErrorLine("template expects list or export")
    return 2
  }
  let folder = if parsed.positional.length() > 1 { parsed.positional[1] } else { valueOf(parsed, "--output", "_exported_templates/default") }
  match Tasks.exportTemplate(folder) {
    case Ok(written) => {
      for path in written { let _said = Io.writeLine("wrote " + Path.join(folder, path)) }
      0
    }
    case Err(problems) => failed(&problems)
  }
}

/// Saves a cross-reference map named by `--xref` into a file.
fn download(parsed: &Parsed) -> Int {
  let address = valueOf(parsed, "--xref", "")
  if parsed.positional.isEmpty() || address.isEmpty() {
    let _said = Io.writeErrorLine("download needs a file and --xref <address>")
    return 2
  }
  match Tasks.download(address, parsed.positional[0]) {
    case Ok(count) => {
      let _said = Io.writeLine("saved " + show(count) + " references to " + parsed.positional[0])
      0
    }
    case Err(problems) => failed(&problems)
  }
}

/// Combines cross-reference maps into the `--output` file.
fn merge(parsed: &Parsed) -> Int {
  let file = valueOf(parsed, "--output", "")
  if parsed.positional.isEmpty() || file.isEmpty() {
    let _said = Io.writeErrorLine("merge needs maps and --output <file>")
    return 2
  }
  match Tasks.merge(&parsed.positional, file) {
    case Ok(count) => {
      let _said = Io.writeLine("merged " + show(count) + " references into " + file)
      0
    }
    case Err(problems) => failed(&problems)
  }
}

/// The value of an option, or the fallback.
fn valueOf(parsed: &Parsed, name: Str, fallback: Str) -> Str {
  var found = fallback
  for (key, value) in parsed.values {
    if key == name { found = value }
  }
  found
}
