/** @Docgen.Api.Lexer — Pudu source reduced to tokens and documentation comments */
module PuduLangDocgen.Api.Lexer

import Std.Char as Char

/** @Docgen.Api.Token — one token with its kind, text, and one-based line */
export type Token = { kind: TokenKind, text: Str, line: Int }

/** @Docgen.Api.TokenKind — the lexical classes declarations are read from */
export type TokenKind = Word | Symbol | Literal | LineDoc | BlockDoc

/// Two-character operators kept as one symbol.
const PAIRS: Array[Str] = ["->", "=>", "==", "!=", "<=", ">=", "&&", "||", "..", "::"]

/// Tokens of a source file; ordinary comments and white space are dropped.
export fn tokens(source: Str) -> Array[Token] {
  let cs = source.chars()
  var result: Array[Token] = []
  var index = 0
  var line = 1
  while index < cs.length() {
    let character = cs[index]
    if character == '\n' {
      line = line + 1
      index = index + 1
    } else if Char.isWhitespace(character) {
      index = index + 1
    } else if startsWith(&cs, index, "///") && !startsWith(&cs, index, "////") {
      var end = index + 3
      while end < cs.length() && cs[end] != '\n' { end = end + 1 }
      let body = slice(&cs, index + 3, end)
      result = result.push(Token{kind: LineDoc, text: if body.startsWith(" ") { body.drop(1) } else { body }, line: line})
      index = end
    } else if startsWith(&cs, index, "//") {
      while index < cs.length() && cs[index] != '\n' { index = index + 1 }
    } else if startsWith(&cs, index, "/*") {
      let documented = startsWith(&cs, index, "/**") && !startsWith(&cs, index, "/**/")
      var end = index + 2
      var depth = 1
      let first = line
      while end < cs.length() && depth > 0 {
        if startsWith(&cs, end, "/*") {
          depth = depth + 1
          end = end + 2
        } else if startsWith(&cs, end, "*/") {
          depth = depth - 1
          end = end + 2
        } else {
          if cs[end] == '\n' { line = line + 1 }
          end = end + 1
        }
      }
      if documented { result = result.push(Token{kind: BlockDoc, text: blockText(slice(&cs, index + 3, if depth == 0 { end - 2 } else { end })), line: first}) }
      index = end
    } else if character == '"' {
      let end = stringEnd(&cs, index)
      let text = slice(&cs, index, end)
      result = result.push(Token{kind: Literal, text: text, line: line})
      for held in text.chars() {
        if held == '\n' { line = line + 1 }
      }
      index = end
    } else if character == '\'' && charLiteral(&cs, index) > index {
      let end = charLiteral(&cs, index)
      result = result.push(Token{kind: Literal, text: slice(&cs, index, end), line: line})
      index = end
    } else if Char.isAlphanumeric(character) || character == '_' {
      var end = index + 1
      while end < cs.length() && (Char.isAlphanumeric(cs[end]) || cs[end] == '_') { end = end + 1 }
      let text = slice(&cs, index, end)
      result = result.push(Token{kind: if Char.isDigit(character) { Literal } else { Word }, text: text, line: line})
      index = end
    } else {
      let pair = if index + 1 < cs.length() { slice(&cs, index, index + 2) } else { "" }
      if PAIRS.contains(pair) {
        result = result.push(Token{kind: Symbol, text: pair, line: line})
        index = index + 2
      } else {
        result = result.push(Token{kind: Symbol, text: character.toText(), line: line})
        index = index + 1
      }
    }
  }
  result
}

/// Whether text continues with a prefix at an index.
fn startsWith(cs: &Array[Char], index: Int, prefix: Str) -> Bool {
  let wanted = prefix.chars()
  if index + wanted.length() > cs.length() { return false }
  for offset in 0..wanted.length() {
    if cs[index + offset] != wanted[offset] { return false }
  }
  true
}

/// Text of the characters in a half-open range.
fn slice(cs: &Array[Char], from: Int, to: Int) -> Str {
  var pieces: Array[Str] = []
  for index in from..to { pieces = pieces.push(cs[index].toText()) }
  pieces.join("")
}

/// The index after a string literal, following interpolations and the strings inside them.
fn stringEnd(cs: &Array[Char], index: Int) -> Int {
  var end = index + 1
  var depth = 0
  while end < cs.length() {
    let character = cs[end]
    if character == '\\' {
      end = end + 2
      continue
    }
    if depth == 0 && character == '"' { return end + 1 }
    if character == '{' { depth = depth + 1 }
    if character == '}' && depth > 0 { depth = depth - 1 }
    if depth > 0 && character == '"' {
      end = stringEnd(cs, end)
      continue
    }
    end = end + 1
  }
  end
}

/// The index after a character literal at an index, or the index itself when there is none.
fn charLiteral(cs: &Array[Char], index: Int) -> Int {
  if index + 2 < cs.length() && cs[index + 1] != '\\' && cs[index + 2] == '\'' { return index + 3 }
  if index + 1 < cs.length() && cs[index + 1] == '\\' {
    var end = index + 2
    while end < cs.length() && end - index < 12 && cs[end] != '\'' { end = end + 1 }
    if end < cs.length() && cs[end] == '\'' { return end + 1 }
  }
  index
}

/// The text of a block documentation comment without its leading asterisks.
fn blockText(inner: Str) -> Str {
  let lines = inner.split("\n").map(fn(line: Str) -> Str {
      let trimmed = line.trim()
      if trimmed.startsWith("* ") { trimmed.drop(2) } else if trimmed == "*" { "" } else { trimmed }
    })
  lines.join("\n").trim()
}
