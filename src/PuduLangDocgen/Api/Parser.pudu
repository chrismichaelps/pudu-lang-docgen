/** @Docgen.Api.Parser — module declarations and their documentation read from tokens */
module PuduLangDocgen.Api.Parser

import PuduLangDocgen.Api.Lexer as Lexer
import PuduLangDocgen.Api.Model as Model

/// Words that begin a declaration at module scope.
const STARTS: Array[Str] = ["export", "type", "trait", "impl", "const", "async", "module", "import"]

/// Longest constant value shown in its signature.
const VALUE_LIMIT: Int = 60

/// Symbols written without a space before them.
const TIGHT_BEFORE: Array[Str] = [")", "]", ",", ":", ".", "?"]

/// Symbols written without a space after them.
const TIGHT_AFTER: Array[Str] = ["(", "[", ".", "&", "*", "!"]

/// The module declared in a source file at a project-relative path.
export fn parse(path: Str, source: Str) -> Model.Unit {
  let tokens = Lexer.tokens(source)
  var unit = Model.Unit{uid: fallbackName(path), path: path, doc: "", line: 1, imports: [], members: [], implementations: []}
  var doc = ""
  var exported = false
  var index = 0
  while index < tokens.length() {
    let token = tokens[index]
    let word = if token.kind == Lexer.Word { token.text } else { "" }
    if token.kind == Lexer.LineDoc || token.kind == Lexer.BlockDoc {
      let (text, next) = docAt(&tokens, index)
      doc = text
      index = next
    } else if word == "export" {
      exported = true
      index = index + 1
    } else if word == "module" {
      let (name, next) = dotted(&tokens, index + 1)
      unit = Model.Unit{..unit, uid: name, doc: doc, line: token.line}
      doc = ""
      index = next
    } else if word == "import" {
      let (name, next) = dotted(&tokens, index + 1)
      var alias = name.split(".")[name.split(".").length() - 1]
      var after = next
      if after + 1 < tokens.length() && tokens[after].text == "as" {
        alias = tokens[after + 1].text
        after = after + 2
      }
      unit = Model.Unit{..unit, imports: unit.imports.push((alias, name))}
      index = after
    } else if word == "fn" || word == "async" || word == "type" || word == "trait" || word == "const" {
      let (found, next) = declaration(&tokens, index, doc, exported, unit.uid)
      unit = Model.Unit{..unit, members: unit.members.push(found)}
      doc = ""
      exported = false
      index = next
    } else if word == "impl" {
      let (held, next) = implementation(&tokens, index)
      unit = Model.Unit{..unit, implementations: unit.implementations.push(held)}
      doc = ""
      exported = false
      index = next
    } else {
      doc = ""
      exported = false
      index = index + 1
    }
  }
  unit
}

/// Tokens joined the way declarations are conventionally written.
export fn render(tokens: &Array[Lexer.Token], from: Int, to: Int) -> Str {
  var pieces: Array[Str] = []
  var previous = ""
  for index in from..to {
    if tokens[index].kind == Lexer.LineDoc || tokens[index].kind == Lexer.BlockDoc { continue }
    let text = tokens[index].text
    let spaced = !pieces.isEmpty() && !TIGHT_BEFORE.contains(text) && !TIGHT_AFTER.contains(previous) && !((text == "(" || text == "[") && previous != "->" && previous != "=" && previous != "|" && previous != "," && previous != ":")
    if spaced { pieces = pieces.push(" ") }
    pieces = pieces.push(text)
    previous = text
  }
  pieces.join("")
}

/// The module name implied by a source path when the file declares none.
fn fallbackName(path: Str) -> Str {
  let trimmed = if path.endsWith(".pudu") { path.take(path.length() - 5) } else { path }
  let parts = trimmed.split("/")
  parts[parts.length() - 1]
}

/// Consecutive documentation comments as one text, and the index after them.
fn docAt(tokens: &Array[Lexer.Token], index: Int) -> (Str, Int) {
  if tokens[index].kind == Lexer.BlockDoc { return (anchorless(tokens[index].text), index + 1) }
  var lines: Array[Str] = []
  var cursor = index
  while cursor < tokens.length() && tokens[cursor].kind == Lexer.LineDoc {
    lines = lines.push(tokens[cursor].text)
    cursor = cursor + 1
  }
  (lines.join("\n"), cursor)
}

/// Documentation of a namespace anchor `@Name.Role — text` reduced to its text.
fn anchorless(text: Str) -> Str {
  if !text.startsWith("@") { return text }
  for dash in [" — ", " – ", " - "] {
    let at = text.indexOf(dash)
    if at > 0 {
      let rest = text.drop(at + dash.length()).trim()
      return rest.take(1).toUpper() + rest.drop(1)
    }
  }
  text
}

/// A dotted name and the index after it.
fn dotted(tokens: &Array[Lexer.Token], index: Int) -> (Str, Int) {
  var parts: Array[Str] = []
  var cursor = index
  while cursor < tokens.length() && tokens[cursor].kind == Lexer.Word {
    parts = parts.push(tokens[cursor].text)
    cursor = cursor + 1
    if cursor < tokens.length() && tokens[cursor].text == "." { cursor = cursor + 1 } else { break }
  }
  (parts.join("."), cursor)
}

/// The index after the bracket matching the one at an index.
fn matching(tokens: &Array[Lexer.Token], index: Int) -> Int {
  let open = tokens[index].text
  let close = if open == "(" { ")" } else if open == "[" { "]" } else { "\}" }
  var depth = 0
  var cursor = index
  while cursor < tokens.length() {
    let text = tokens[cursor].text
    if tokens[cursor].kind == Lexer.Symbol {
      if text == open { depth = depth + 1 }
      if text == close {
        depth = depth - 1
        if depth == 0 { return cursor + 1 }
      }
    }
    cursor = cursor + 1
  }
  cursor
}

/// Whether a token starts a new declaration or its documentation.
fn starts(tokens: &Array[Lexer.Token], index: Int) -> Bool {
  let token = tokens[index]
  if token.kind == Lexer.LineDoc || token.kind == Lexer.BlockDoc { return true }
  if token.kind != Lexer.Word { return false }
  if STARTS.contains(token.text) { return true }
  token.text == "fn" && index + 1 < tokens.length() && tokens[index + 1].kind == Lexer.Word
}

/// The index of the next declaration start or closing brace outside brackets.
fn nextStart(tokens: &Array[Lexer.Token], index: Int) -> Int {
  var cursor = index
  var depth = 0
  while cursor < tokens.length() {
    let text = tokens[cursor].text
    let symbol = tokens[cursor].kind == Lexer.Symbol
    if depth == 0 && (starts(tokens, cursor) || (symbol && text == "\}")) { return cursor }
    if symbol && (text == "(" || text == "[" || text == "\{") { depth = depth + 1 }
    if symbol && (text == ")" || text == "]" || text == "\}") { depth = depth - 1 }
    cursor = cursor + 1
  }
  cursor
}

/// Token ranges between commas at the top level of a bracketed list.
fn listed(tokens: &Array[Lexer.Token], from: Int, to: Int) -> Array[(Int, Int)] {
  var result: Array[(Int, Int)] = []
  var start = from
  var depth = 0
  for index in from..to {
    if tokens[index].kind == Lexer.LineDoc || tokens[index].kind == Lexer.BlockDoc { continue }
    let text = tokens[index].text
    if tokens[index].kind == Lexer.Symbol {
      if text == "(" || text == "[" || text == "\{" { depth = depth + 1 }
      if text == ")" || text == "]" || text == "\}" { depth = depth - 1 }
      if text == "," && depth == 0 {
        if index > start { result = result.push((start, index)) }
        start = index + 1
      }
    }
  }
  if to > start { result.push((start, to)) } else { result }
}

/// A function, type, trait, or constant declaration at an index.
fn declaration(tokens: &Array[Lexer.Token], index: Int, doc: Str, exported: Bool, owner: Str) -> (Model.Member, Int) {
  let word = tokens[index].text
  if word == "type" { return typeAt(tokens, index, doc, exported, owner) }
  if word == "trait" { return traitAt(tokens, index, doc, exported, owner) }
  if word == "const" { return constAt(tokens, index, doc, exported, owner) }
  function(tokens, index, doc, exported, owner, "function")
}

/// An empty member of a kind.
fn member(uid: Str, name: Str, kind: Str, doc: Str, line: Int, exported: Bool) -> Model.Member {
  Model.Member{uid: uid, name: name, kind: kind, signature: "", doc: doc, line: line, exported: exported, parameters: [], returns: "", members: []}
}

/// A function or method; bodies, when present, are skipped.
fn function(tokens: &Array[Lexer.Token], index: Int, doc: Str, exported: Bool, owner: Str, kind: Str) -> (Model.Member, Int) {
  let start = index
  var cursor = if tokens[index].text == "async" { index + 1 } else { index }
  let name = if cursor + 1 < tokens.length() { tokens[cursor + 1].text } else { "" }
  cursor = cursor + 2
  if cursor < tokens.length() && tokens[cursor].text == "[" { cursor = matching(tokens, cursor) }
  var parameters: Array[Model.Parameter] = []
  if cursor < tokens.length() && tokens[cursor].text == "(" {
    let close = matching(tokens, cursor)
    for (from, to) in listed(tokens, cursor + 1, close - 1) {
      let colon = if from + 1 < to && tokens[from + 1].text == ":" { from + 2 } else { from + 1 }
      parameters = parameters.push(Model.Parameter{name: tokens[from].text, kind: render(tokens, colon, to)})
    }
    cursor = close
  }
  var returns = ""
  if cursor < tokens.length() && tokens[cursor].text == "->" {
    var end = cursor + 1
    var depth = 0
    while end < tokens.length() {
      let text = tokens[end].text
      if depth == 0 && (text == "\{" || text == "=" || text == "\}" || starts(tokens, end)) { break }
      if text == "(" || text == "[" { depth = depth + 1 }
      if text == ")" || text == "]" { depth = depth - 1 }
      end = end + 1
    }
    returns = render(tokens, cursor + 1, end)
    cursor = end
  }
  let signature = render(tokens, start, cursor)
  if cursor < tokens.length() && tokens[cursor].text == "\{" { cursor = matching(tokens, cursor) }
    else if cursor < tokens.length() && tokens[cursor].text == "=" { cursor = nextStart(tokens, cursor + 1) }
  let found = member(owner + "." + name, name, kind, doc, tokens[index].line, exported)
  (Model.Member{..found, signature: signature, parameters: parameters, returns: returns}, cursor)
}

/// A record, union, alias, or opaque type.
fn typeAt(tokens: &Array[Lexer.Token], index: Int, doc: Str, exported: Bool, owner: Str) -> (Model.Member, Int) {
  let name = tokens[index + 1].text
  let uid = owner + "." + name
  var cursor = index + 2
  if cursor < tokens.length() && tokens[cursor].text == "[" { cursor = matching(tokens, cursor) }
  let head = render(tokens, index, cursor)
  let base = member(uid, name, "opaque", doc, tokens[index].line, exported)
  if cursor >= tokens.length() || tokens[cursor].text != "=" { return (Model.Member{..base, signature: head}, cursor) }
  cursor = cursor + 1
  if cursor < tokens.length() && tokens[cursor].text == "\{" {
    let close = matching(tokens, cursor)
    var fields: Array[Model.Member] = []
    var fieldDoc = ""
    for (start, end) in listed(tokens, cursor + 1, close - 1) {
      var first = start
      while first < end && (tokens[first].kind == Lexer.LineDoc || tokens[first].kind == Lexer.BlockDoc) {
        let (text, next) = docAt(tokens, first)
        fieldDoc = text
        first = next
      }
      if first + 2 <= end {
        let field = member(uid + "." + tokens[first].text, tokens[first].text, "field", fieldDoc, tokens[first].line, exported)
        fields = fields.push(Model.Member{..field, signature: render(tokens, first, end), returns: render(tokens, first + 2, end)})
      }
      fieldDoc = ""
    }
    let written = if fields.length() > 2 { head + " = \{\n" + fields.map(|field: Model.Member| "  " + field.signature).join(",\n") + "\n\}" } else { head + " = " + render(tokens, cursor, close) }
    return (Model.Member{..base, kind: "record", signature: written, members: fields}, close)
  }
  let end = nextStart(tokens, cursor)
  var variants: Array[Model.Member] = []
  var start = cursor
  var depth = 0
  for position in cursor..(end + 1) {
    let boundary = position == end || (depth == 0 && tokens[position].text == "|")
    if position < end {
      let text = tokens[position].text
      if text == "(" || text == "[" { depth = depth + 1 }
      if text == ")" || text == "]" { depth = depth - 1 }
    }
    if boundary && position > start {
      let variant = member(uid + "." + tokens[start].text, tokens[start].text, "variant", "", tokens[start].line, exported)
      variants = variants.push(Model.Member{..variant, signature: render(tokens, start, position), returns: render(tokens, start + 1, position)})
      start = position + 1
    } else if boundary { start = position + 1 }
  }
  let union = variants.length() > 1 || (variants.length() == 1 && cursor + 1 < end && tokens[cursor + 1].text == "(")
  let written = head + " = " + render(tokens, cursor, end)
  if union { (Model.Member{..base, kind: "union", signature: written, members: variants}, end) } else { (Model.Member{..base, kind: "alias", signature: written, returns: render(tokens, cursor, end)}, end) }
}

/// A trait and the methods it requires.
fn traitAt(tokens: &Array[Lexer.Token], index: Int, doc: Str, exported: Bool, owner: Str) -> (Model.Member, Int) {
  let name = tokens[index + 1].text
  let uid = owner + "." + name
  var cursor = index + 2
  if cursor < tokens.length() && tokens[cursor].text == "[" { cursor = matching(tokens, cursor) }
  let signature = render(tokens, index, cursor)
  if cursor >= tokens.length() || tokens[cursor].text != "\{" { return (Model.Member{..member(uid, name, "trait", doc, tokens[index].line, exported), signature: signature}, cursor) }
  let close = matching(tokens, cursor)
  let methods = methodsIn(tokens, cursor + 1, close - 1, uid, exported)
  (Model.Member{..member(uid, name, "trait", doc, tokens[index].line, exported), signature: signature, members: methods}, close)
}

/// Documented methods between two indexes.
fn methodsIn(tokens: &Array[Lexer.Token], from: Int, to: Int, owner: Str, exported: Bool) -> Array[Model.Member] {
  var methods: Array[Model.Member] = []
  var doc = ""
  var cursor = from
  while cursor < to {
    let token = tokens[cursor]
    if token.kind == Lexer.LineDoc || token.kind == Lexer.BlockDoc {
      let (text, next) = docAt(tokens, cursor)
      doc = text
      cursor = next
    } else if token.kind == Lexer.Word && (token.text == "fn" || token.text == "async") {
      let (method, next) = function(tokens, cursor, doc, exported, owner, "method")
      methods = methods.push(method)
      doc = ""
      cursor = if next > cursor { next } else { cursor + 1 }
    } else { cursor = cursor + 1 }
  }
  methods
}

/// An implementation of a trait for a type.
fn implementation(tokens: &Array[Lexer.Token], index: Int) -> (Model.Implementation, Int) {
  var cursor = index + 1
  if cursor < tokens.length() && tokens[cursor].text == "[" { cursor = matching(tokens, cursor) }
  let start = cursor
  while cursor < tokens.length() && tokens[cursor].text != "for" && tokens[cursor].text != "\{" { cursor = cursor + 1 }
  var contract = ""
  var target = render(tokens, start, cursor)
  if cursor < tokens.length() && tokens[cursor].text == "for" {
    contract = target
    let after = cursor + 1
    cursor = after
    while cursor < tokens.length() && tokens[cursor].text != "\{" { cursor = cursor + 1 }
    target = render(tokens, after, cursor)
  }
  if cursor >= tokens.length() { return (Model.Implementation{contract: contract, target: target, line: tokens[index].line, methods: []}, cursor) }
  let close = matching(tokens, cursor)
  (Model.Implementation{contract: contract, target: target, line: tokens[index].line, methods: methodsIn(tokens, cursor + 1, close - 1, target, true)}, close)
}

/// A constant with its type and, when short, its value.
fn constAt(tokens: &Array[Lexer.Token], index: Int, doc: Str, exported: Bool, owner: Str) -> (Model.Member, Int) {
  let name = tokens[index + 1].text
  var cursor = index + 2
  var kind = ""
  if cursor < tokens.length() && tokens[cursor].text == ":" {
    let from = cursor + 1
    while cursor < tokens.length() && tokens[cursor].text != "=" && !starts(tokens, cursor) { cursor = cursor + 1 }
    kind = render(tokens, from, cursor)
  }
  var signature = render(tokens, index, cursor)
  if cursor < tokens.length() && tokens[cursor].text == "=" {
    let end = nextStart(tokens, cursor + 1)
    let value = render(tokens, cursor + 1, end)
    if value.length() <= VALUE_LIMIT && !value.contains("\n") { signature = signature + " = " + value }
    cursor = end
  }
  (Model.Member{..member(owner + "." + name, name, "constant", doc, tokens[index].line, exported), signature: signature, returns: kind}, cursor)
}
