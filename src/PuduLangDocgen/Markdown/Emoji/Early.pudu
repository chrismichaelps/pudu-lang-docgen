/// The emoji a short code names.
export fn lookup(code: Str) -> Option[Str] {
  if Map.containsKey(&PART_1, code) { return Map.get(&PART_1, code) }
  if Map.containsKey(&PART_2, code) { return Map.get(&PART_2, code) }
  if Map.containsKey(&PART_3, code) { return Map.get(&PART_3, code) }
  if Map.containsKey(&PART_4, code) { return Map.get(&PART_4, code) }
  if Map.containsKey(&PART_5, code) { return Map.get(&PART_5, code) }
  if Map.containsKey(&PART_6, code) { return Map.get(&PART_6, code) }
  if Map.containsKey(&PART_7, code) { return Map.get(&PART_7, code) }
  None
}
