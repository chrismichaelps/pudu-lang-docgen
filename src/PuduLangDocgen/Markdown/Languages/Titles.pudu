    ("xc", "XC"), ("xcompose", "XCompose"), ("xmake", "Xmake"), ("xml", "XML"), ("xml-property-list", "XML Property List"), ("xojo", "Xojo"), ("xonsh", "Xonsh"),
    ("xpages", "XPages"), ("xproc", "XProc"), ("xquery", "XQuery"), ("xs", "XS"), ("xslt", "XSLT"), ("xtend", "Xtend"), ("yacc", "Yacc"),
    ("yaml", "YAML"), ("yang", "YANG"), ("yara", "YARA"), ("yasnippet", "YASnippet"), ("yul", "Yul"), ("zap", "ZAP"), ("zeek", "Zeek"),
    ("zenscript", "ZenScript"), ("zephir", "Zephir"), ("zig", "Zig"), ("zil", "ZIL"), ("zimpl", "Zimpl"), ("zmodel", "Zmodel")
  ])

/// The value stored for a key.
export fn lookup(key: Str) -> Option[Str] {
  if Map.containsKey(&PART_1, key) { return Map.get(&PART_1, key) }
  if Map.containsKey(&PART_2, key) { return Map.get(&PART_2, key) }
  if Map.containsKey(&PART_3, key) { return Map.get(&PART_3, key) }
  None
}
