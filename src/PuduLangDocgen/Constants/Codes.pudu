/** @Docgen.Constants.Codes — stable diagnostic codes reported by every phase */
module PuduLangDocgen.Constants.Codes

/// A code fence or math block runs to the end of its container.
export const UNCLOSED_BLOCK: Str = "DG101"

/// An included file is not part of the loaded files.
export const INCLUDE_MISSING: Str = "DG102"

/// Files include one another in a cycle.
export const INCLUDE_CYCLE: Str = "DG103"

/// Content nests past the parser's depth bound and is kept as text.
export const NESTING_TOO_DEEP: Str = "DG104"

/// A code excerpt names a file that is not loaded.
export const EXCERPT_MISSING: Str = "DG105"

/// A code excerpt's region, range, or options cannot be applied.
export const EXCERPT_INVALID: Str = "DG106"

/// A quote names an alert kind that is not configured.
export const UNKNOWN_ALERT: Str = "DG107"

/// A container directive is unsupported or lacks a required attribute.
export const DIRECTIVE_INVALID: Str = "DG108"

/// A YAML header is unclosed or not a mapping.
export const FRONT_MATTER_INVALID: Str = "DG109"

/// A container directive has no matching end line.
export const DIRECTIVE_UNCLOSED: Str = "DG110"

/// An include or excerpt path is absolute, encoded, or not portable.
export const PATH_INVALID: Str = "DG111"

/// A link destination uses a scheme or form that is never linked.
export const UNSAFE_DESTINATION: Str = "DG121"

/// A local destination leaves the project root.
export const DESTINATION_ESCAPES: Str = "DG122"

/// A local link names a file that is not published.
export const LINK_BROKEN: Str = "DG123"

/// A cross reference names an identity no page or map declares.
export const XREF_UNRESOLVED: Str = "DG124"

/// A link names a section its target page does not have.
export const FRAGMENT_MISSING: Str = "DG127"

/// An image names a file that is not published.
export const IMAGE_MISSING: Str = "DG125"

/// An embedded video does not use HTTPS.
export const VIDEO_INSECURE: Str = "DG126"

/// A table of contents is not valid YAML or JSON.
export const TOC_SYNTAX: Str = "DG201"

/// A table of contents or one of its items has the wrong shape.
export const TOC_SHAPE: Str = "DG202"

/// A Markdown table of contents heading has no title.
export const TOC_HEADING_EMPTY: Str = "DG203"

/// A table of contents destination is unsafe.
export const TOC_UNSAFE: Str = "DG204"

/// A table of contents nests past its depth bound.
export const TOC_TOO_DEEP: Str = "DG205"

/// A table of contents item declares an unknown field.
export const TOC_UNKNOWN_FIELD: Str = "DG206"

/// A table of contents item has neither a name nor a uid.
export const TOC_NAMELESS: Str = "DG207"

/// A table of contents item names an unknown uid.
export const TOC_UID_UNKNOWN: Str = "DG210"

/// A table of contents destination is not published.
export const TOC_TARGET_MISSING: Str = "DG211"

/// Tables of contents include one another in a cycle or too deeply.
export const TOC_CYCLE: Str = "DG212"

/// Two pages declare the same uid.
export const UID_DUPLICATE: Str = "DG301"

/// A layout or partial template does not parse.
export const TEMPLATE_INVALID: Str = "DG401"

/// A configuration value is missing, unknown, or of the wrong type.
export const CONFIG_INVALID: Str = "DG501"

/// A configuration file cannot be read or decoded.
export const CONFIG_UNREADABLE: Str = "DG502"

/// A content file listed by the configuration cannot be read.
export const CONTENT_UNREADABLE: Str = "DG601"

/// A structured content file does not decode or describes an invalid interface.
export const CONTENT_INVALID: Str = "DG602"

/// A content file has a type the build does not publish.
export const CONTENT_UNSUPPORTED: Str = "DG603"

/// An overwrite section header is malformed or names no uid.
export const OVERWRITE_INVALID: Str = "DG701"

/// An output path is not portable.
export const OUTPUT_INVALID: Str = "DG801"

/// Two outputs share a path, or a file takes a folder's path.
export const OUTPUT_COLLISION: Str = "DG802"

/// A configuration selects no content and no API sources.
export const NOTHING_TO_BUILD: Str = "DG901"

/// A project file or folder cannot be read safely.
export const FILE_UNREADABLE: Str = "DG902"

/// Output could not be written, or a publication path is unsafe.
export const PUBLISH_FAILED: Str = "DG903"

/// A cross-reference map could not be fetched or read.
export const XREF_UNAVAILABLE: Str = "DG904"

/// An external tool the command needs is missing or failed.
export const TOOL_FAILED: Str = "DG905"
