/** @Docgen.Theme.Script — the default site behavior: navigation, tabs, search, and theme */
module PuduLangDocgen.Theme.Script

/// Script lines, loaded deferred and working without any other library.
const LINES: Array[Str] = [
  "(function () \{",
  "  \"use strict\";",
  "  var root = document.documentElement.getAttribute(\"data-root\") || \"\";",
  "  var store = \{",
  "    get: function (key) \{ try \{ return window.localStorage.getItem(key); \} catch (e) \{ return null; \} \},",
  "    set: function (key, value) \{ try \{ window.localStorage.setItem(key, value); \} catch (e) \{ return; \} \}",
  "  \};",
  "  var THEMES = [\"auto\", \"light\", \"dark\"];",
  "",
  "  function each(selector, action, scope) \{",
  "    Array.prototype.forEach.call((scope || document).querySelectorAll(selector), action);",
  "  \}",
  "",
  "  function setupTheme() \{",
  "    var button = document.querySelector(\".theme-toggle\");",
  "    if (!button) \{ return; \}",
  "    var label = button.getAttribute(\"aria-label\");",
  "    var system = window.matchMedia ? window.matchMedia(\"(prefers-color-scheme: dark)\") : null;",
  "    function shown() \{",
  "      var chosen = document.documentElement.getAttribute(\"data-theme\") || \"auto\";",
  "      if (chosen !== \"auto\") \{ return chosen; \}",
  "      return system && system.matches ? \"dark\" : \"light\";",
  "    \}",
  "    function apply(theme) \{",
  "      document.documentElement.setAttribute(\"data-theme\", theme);",
  "      button.setAttribute(\"aria-pressed\", shown() === \"dark\" ? \"true\" : \"false\");",
  "      button.title = label + \": \" + shown();",
  "    \}",
  "    var saved = store.get(\"docgen-theme\");",
  "    apply(THEMES.indexOf(saved) >= 0 ? saved : \"auto\");",
  "    button.addEventListener(\"click\", function () \{",
  "      var next = shown() === \"dark\" ? \"light\" : \"dark\";",
  "      store.set(\"docgen-theme\", next);",
  "      apply(next);",
  "    \});",
  "    if (system && system.addEventListener) \{",
  "      system.addEventListener(\"change\", function () \{ apply(document.documentElement.getAttribute(\"data-theme\") || \"auto\"); \});",
  "    \}",
  "  \}",
  "",
  "  function setupMenu() \{",
  "    panel(document.querySelector(\".menu-toggle\"), document.getElementById(\"sidebar\"));",
  "    panel(document.querySelector(\".nav-toggle\"), document.getElementById(\"navbar\"));",
  "  \}",
  "",
  "  function panel(toggle, sidebar) \{",
  "    if (!toggle || !sidebar) \{ return; \}",
  "    toggle.addEventListener(\"click\", function () \{",
  "      var open = sidebar.classList.toggle(\"open\");",
  "      toggle.setAttribute(\"aria-expanded\", open ? \"true\" : \"false\");",
  "    \});",
  "    document.addEventListener(\"keydown\", function (event) \{",
  "      if (event.key === \"Escape\" && sidebar.classList.contains(\"open\")) \{",
  "        sidebar.classList.remove(\"open\");",
  "        toggle.setAttribute(\"aria-expanded\", \"false\");",
  "        toggle.focus();",
  "      \}",
  "    \});",
  "  \}",
  "",
  "  function setupToc() \{",
  "    var toc = document.querySelector(\".toc\");",
  "    if (!toc) \{ return; \}",
  "    var here = window.location.pathname.replace(/\\/index\\.html$/, \"/\");",
  "    each(\"a\", function (link) \{",
  "      var target = link.pathname.replace(/\\/index\\.html$/, \"/\");",
  "      if (target === here && !link.hash) \{",
  "        link.classList.add(\"active\");",
  "        link.setAttribute(\"aria-current\", \"page\");",
  "        var item = link.parentElement;",
  "        while (item && item !== toc) \{",
  "          if (item.tagName === \"LI\") \{ item.classList.add(\"expanded\"); \}",
  "          item = item.parentElement;",
  "        \}",
  "      \}",
  "    \}, toc);",
  "    each(\".toc-group\", function (group) \{",
  "      group.addEventListener(\"click\", function () \{",
  "        var item = group.parentElement;",
  "        var open = item.classList.toggle(\"expanded\");",
  "        group.setAttribute(\"aria-expanded\", open ? \"true\" : \"false\");",
  "      \});",
  "    \}, toc);",
  "    var active = toc.querySelector(\"a.active\");",
  "    if (active && active.scrollIntoView) \{ active.scrollIntoView(\{ block: \"center\" \}); \}",
  "    var filter = document.querySelector(\".toc-filter input\");",
  "    if (!filter) \{ return; \}",
  "    filter.addEventListener(\"input\", function () \{",
  "      var words = filter.value.toLowerCase().split(/\\s+/).filter(Boolean);",
  "      each(\"li\", function (item) \{",
  "        var text = item.textContent.toLowerCase();",
  "        var match = words.every(function (word) \{ return text.indexOf(word) >= 0; \});",
  "        item.classList.toggle(\"filtered-out\", words.length > 0 && !match);",
  "        if (words.length > 0 && match) \{ item.classList.add(\"expanded\"); \}",
  "      \}, toc);",
  "    \});",
  "  \}",
  "",
  "  function setupCopy() \{",
  "    each(\".code-block .copy\", function (button) \{",
  "      button.addEventListener(\"click\", function () \{",
  "        var code = button.closest(\".code-block\").querySelector(\"code\");",
  "        var text = code ? code.innerText : \"\";",
  "        var done = function () \{",
  "          var label = button.textContent;",
  "          button.textContent = \"Copied\";",
  "          window.setTimeout(function () \{ button.textContent = label; \}, 1500);",
  "        \};",
  "        if (navigator.clipboard) \{ navigator.clipboard.writeText(text).then(done, function () \{ return; \}); \}",
  "      \});",
  "    \});",
  "  \}",
  "",
  "  var chosenTabs = [];",
  "",
  "  function selectTab(id) \{",
  "    chosenTabs = [id].concat(chosenTabs.filter(function (other) \{ return other !== id; \}));",
  "    each(\".tabs\", function (group) \{",
  "      var buttons = group.querySelectorAll('[role=\"tab\"]');",
  "      var owned = Array.prototype.map.call(buttons, function (button) \{ return button.getAttribute(\"data-tab\"); \});",
  "      var active = chosenTabs.filter(function (candidate) \{ return owned.indexOf(candidate) >= 0; \})[0];",
  "      if (!active) \{ return; \}",
  "      Array.prototype.forEach.call(buttons, function (button) \{",
  "        var chosen = button.getAttribute(\"data-tab\") === active;",
  "        button.setAttribute(\"aria-selected\", chosen ? \"true\" : \"false\");",
  "        button.tabIndex = chosen ? 0 : -1;",
  "      \});",
  "      var panels = Array.prototype.filter.call(group.querySelectorAll('[role=\"tabpanel\"]'), function (panel) \{ return panel.parentElement === group; \});",
  "      var matching = panels.filter(function (panel) \{ return panel.getAttribute(\"data-tab\") === active; \});",
  "      var shown = matching.filter(function (panel) \{",
  "        var condition = panel.getAttribute(\"data-condition\");",
  "        return condition && chosenTabs.indexOf(condition) >= 0;",
  "      \})[0] || matching.filter(function (panel) \{ return !panel.getAttribute(\"data-condition\"); \})[0] || matching[0];",
  "      panels.forEach(function (panel) \{ panel.hidden = panel !== shown; \});",
  "    \});",
  "  \}",
  "",
  "  function setupTabs() \{",
  "    each('.tabs [role=\"tab\"]', function (button) \{",
  "      button.addEventListener(\"click\", function () \{",
  "        var id = button.getAttribute(\"data-tab\");",
  "        selectTab(id);",
  "        store.set(\"docgen-tabs\", chosenTabs.slice(0, 8).join(\",\"));",
  "      \});",
  "      button.addEventListener(\"keydown\", function (event) \{",
  "        if (event.key !== \"ArrowRight\" && event.key !== \"ArrowLeft\") \{ return; \}",
  "        var list = Array.prototype.slice.call(button.parentElement.children);",
  "        var step = event.key === \"ArrowRight\" ? 1 : -1;",
  "        var next = list[(list.indexOf(button) + step + list.length) % list.length];",
  "        next.focus();",
  "        next.click();",
  "      \});",
  "    \});",
  "    each(\".tabs\", function (group) \{",
  "      var first = group.querySelector('[role=\"tab\"]');",
  "      if (first && chosenTabs.indexOf(first.getAttribute(\"data-tab\")) < 0) \{ chosenTabs.push(first.getAttribute(\"data-tab\")); \}",
  "    \});",
  "    var remembered = (store.get(\"docgen-tabs\") || \"\").split(\",\").filter(Boolean);",
  "    remembered.reverse().forEach(function (id) \{ selectTab(id); \});",
  "    if (remembered.length === 0 && chosenTabs.length > 0) \{ selectTab(chosenTabs[0]); \}",
  "  \}",
  "",
  "  function setupAffix() \{",
  "    var links = Array.prototype.slice.call(document.querySelectorAll(\".affix a\"));",
  "    if (links.length === 0 || !(\"IntersectionObserver\" in window)) \{ return; \}",
  "    var byId = \{\};",
  "    links.forEach(function (link) \{ byId[decodeURIComponent(link.hash.slice(1))] = link; \});",
  "    var visible = \{\};",
  "    var observer = new IntersectionObserver(function (entries) \{",
  "      entries.forEach(function (entry) \{ visible[entry.target.id] = entry.isIntersecting; \});",
  "      var current = null;",
  "      links.forEach(function (link) \{",
  "        var id = decodeURIComponent(link.hash.slice(1));",
  "        if (current === null && visible[id]) \{ current = link; \}",
  "      \});",
  "      if (current) \{",
  "        links.forEach(function (link) \{ link.classList.toggle(\"active\", link === current); \});",
  "      \}",
  "    \}, \{ rootMargin: \"-60px 0px -60% 0px\" \});",
  "    Object.keys(byId).forEach(function (id) \{",
  "      var heading = document.getElementById(id);",
  "      if (heading) \{ observer.observe(heading); \}",
  "    \});",
  "  \}",
  "",
  "  function tokens(text) \{",
  "    return text.toLowerCase().split(/[^\\p\{L\}\\p\{N\}_]+/u).filter(function (word) \{ return word.length > 0; \});",
  "  \}",
  "",
  "  function score(entry, words) \{",
  "    var title = entry.title.toLowerCase();",
  "    var text = entry.text.toLowerCase();",
  "    var total = 0;",
  "    for (var i = 0; i < words.length; i++) \{",
  "      var word = words[i];",
  "      var inTitle = title.indexOf(word);",
  "      var inText = text.indexOf(word);",
  "      if (inTitle < 0 && inText < 0) \{ return 0; \}",
  "      if (inTitle === 0) \{ total += 20; \} else if (inTitle > 0) \{ total += 10; \}",
  "      if (inText >= 0) \{ total += 1 + Math.min(5, text.split(word).length - 1); \}",
  "    \}",
  "    return total;",
  "  \}",
  "",
  "  function excerpt(text, words) \{",
  "    var lower = text.toLowerCase();",
  "    var at = lower.indexOf(words[0]);",
  "    var start = Math.max(0, at - 60);",
  "    var piece = text.slice(start, start + 180);",
  "    return (start > 0 ? \"…\" : \"\") + piece + (start + 180 < text.length ? \"…\" : \"\");",
  "  \}",
  "",
  "  function highlighted(text, words) \{",
  "    var fragment = document.createDocumentFragment();",
  "    var lower = text.toLowerCase();",
  "    var index = 0;",
  "    while (index < text.length) \{",
  "      var next = -1;",
  "      var length = 0;",
  "      words.forEach(function (word) \{",
  "        var found = lower.indexOf(word, index);",
  "        if (found >= 0 && (next < 0 || found < next)) \{ next = found; length = word.length; \}",
  "      \});",
  "      if (next < 0) \{ fragment.appendChild(document.createTextNode(text.slice(index))); break; \}",
  "      if (next > index) \{ fragment.appendChild(document.createTextNode(text.slice(index, next))); \}",
  "      var mark = document.createElement(\"mark\");",
  "      mark.textContent = text.slice(next, next + length);",
  "      fragment.appendChild(mark);",
  "      index = next + length;",
  "    \}",
  "    return fragment;",
  "  \}",
  "",
  "  function setupSearch() \{",
  "    var input = document.getElementById(\"search-input\");",
  "    var panel = document.getElementById(\"search-results\");",
  "    if (!input || !panel) \{ return; \}",
  "    var index = null;",
  "    var loading = null;",
  "    var selected = -1;",
  "    function load() \{",
  "      if (loading) \{ return loading; \}",
  "      loading = fetch(root + \"index.json\").then(function (response) \{ return response.json(); \}).then(function (data) \{",
  "        index = data;",
  "        return data;",
  "      \}, function () \{ index = []; return index; \});",
  "      return loading;",
  "    \}",
  "    function close() \{",
  "      panel.hidden = true;",
  "      input.setAttribute(\"aria-expanded\", \"false\");",
  "      selected = -1;",
  "    \}",
  "    function choose(position) \{",
  "      var items = panel.querySelectorAll(\".search-result\");",
  "      if (items.length === 0) \{ return; \}",
  "      selected = (position + items.length) % items.length;",
  "      Array.prototype.forEach.call(items, function (item, at) \{ item.setAttribute(\"aria-selected\", at === selected ? \"true\" : \"false\"); \});",
  "      items[selected].scrollIntoView(\{ block: \"nearest\" \});",
  "    \}",
  "    function show() \{",
  "      var words = tokens(input.value);",
  "      panel.textContent = \"\";",
  "      if (words.length === 0) \{ close(); return; \}",
  "      var ranked = index.map(function (entry) \{ return \{ entry: entry, score: score(entry, words) \}; \})",
  "        .filter(function (hit) \{ return hit.score > 0; \})",
  "        .sort(function (left, right) \{ return right.score - left.score; \})",
  "        .slice(0, 12);",
  "      if (ranked.length === 0) \{",
  "        var empty = document.createElement(\"div\");",
  "        empty.className = \"search-empty\";",
  "        empty.textContent = \"No results for “\" + input.value.trim() + \"”\";",
  "        panel.appendChild(empty);",
  "      \}",
  "      ranked.forEach(function (hit) \{",
  "        var link = document.createElement(\"a\");",
  "        link.className = \"search-result\";",
  "        link.setAttribute(\"role\", \"option\");",
  "        link.href = root + hit.entry.href;",
  "        var title = document.createElement(\"strong\");",
  "        title.appendChild(highlighted(hit.entry.title, words));",
  "        var summary = document.createElement(\"span\");",
  "        summary.appendChild(highlighted(excerpt(hit.entry.summary || hit.entry.text, words), words));",
  "        link.appendChild(title);",
  "        link.appendChild(summary);",
  "        panel.appendChild(link);",
  "      \});",
  "      panel.hidden = false;",
  "      input.setAttribute(\"aria-expanded\", \"true\");",
  "      selected = -1;",
  "    \}",
  "    input.addEventListener(\"focus\", load);",
  "    input.addEventListener(\"input\", function () \{ load().then(show); \});",
  "    input.addEventListener(\"keydown\", function (event) \{",
  "      if (event.key === \"ArrowDown\") \{ event.preventDefault(); choose(selected + 1); \}",
  "      else if (event.key === \"ArrowUp\") \{ event.preventDefault(); choose(selected - 1); \}",
  "      else if (event.key === \"Enter\") \{",
  "        var items = panel.querySelectorAll(\".search-result\");",
  "        var target = items[selected >= 0 ? selected : 0];",
  "        if (target) \{ event.preventDefault(); window.location.href = target.href; \}",
  "      \} else if (event.key === \"Escape\") \{ close(); input.blur(); \}",
  "    \});",
  "    document.addEventListener(\"click\", function (event) \{",
  "      if (!panel.contains(event.target) && event.target !== input) \{ close(); \}",
  "    \});",
  "    document.addEventListener(\"keydown\", function (event) \{",
  "      var typing = /INPUT|TEXTAREA|SELECT/.test(document.activeElement.tagName);",
  "      if (event.key === \"/\" && !typing) \{ event.preventDefault(); input.focus(); \}",
  "    \});",
  "  \}",
  "",
  "  function setupDiagrams() \{",
  "    if (!document.querySelector(\"pre.mermaid\")) \{ return; \}",
  "    window.addEventListener(\"load\", function () \{",
  "      if (!window.mermaid) \{ return; \}",
  "      var dark = document.documentElement.getAttribute(\"data-theme\") === \"dark\" ||",
  "        (document.documentElement.getAttribute(\"data-theme\") === \"auto\" && window.matchMedia(\"(prefers-color-scheme: dark)\").matches);",
  "      window.mermaid.initialize(\{ startOnLoad: false, theme: dark ? \"dark\" : \"default\", securityLevel: \"strict\" \});",
  "      window.mermaid.run(\{ querySelector: \"pre.mermaid\" \});",
  "    \});",
  "  \}",
  "",
  "  function start() \{",
  "    setupTheme();",
  "    setupMenu();",
  "    setupToc();",
  "    setupCopy();",
  "    setupTabs();",
  "    setupAffix();",
  "    setupSearch();",
  "    setupDiagrams();",
  "  \}",
  "",
  "  if (document.readyState === \"loading\") \{ document.addEventListener(\"DOMContentLoaded\", start); \} else \{ start(); \}",
  "\})();"
]

/// The script text published as `_assets/site.js`.
export fn script() -> Str { LINES.join("\n") + "\n" }
