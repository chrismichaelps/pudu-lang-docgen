/** @Docgen.Site.Search — the searchable text of published pages */
module PuduLangDocgen.Site.Search

import Std.Json as Json
import PuduLangDocgen as Docgen
import PuduLangDocgen.Meta as Meta

/// Longest page text kept in the index.
const TEXT_LIMIT: Int = 8000

/// Elements whose content is never searchable text.
const HIDDEN: Array[Str] = ["script", "style", "button"]

/// The search index as JSON: href, title, summary, and text of every indexable page.
/// Pages with `_noindex` and redirect pages are left out.
export fn index(pages: &Array[Docgen.Page]) -> Str {
  var entries: Array[Json.Json] = []
  for page in *pages {
    if page.kind == "redirect" || Meta.flag(&page.meta, "_noindex") { continue }
    let text = plainText(page.body)
    entries = entries.push(Json.object(&[("href", Json.Text(page.path)), ("title", Json.Text(page.title)), ("summary", Json.Text(page.summary)), ("text", Json.Text(text.take(TEXT_LIMIT)))]))
  }
  Json.encode(&Json.list(&entries))
}

/// Visible text of HTML with white space collapsed and common references decoded.
export fn plainText(html: Str) -> Str {
  let cs = html.chars()
  var pieces: Array[Str] = []
  var cursor = 0
  var hidden = ""
  while cursor < cs.length() {
    let character = cs[cursor]
    if character == '<' {
      var end = cursor + 1
      while end < cs.length() && cs[end] != '>' { end = end + 1 }
      var tag: Array[Str] = []
      for position in (cursor + 1)..end { tag = tag.push(cs[position].toText()) }
      let name = tag.join("").split(" ")[0].toLower()
      if hidden.isEmpty() && HIDDEN.contains(name) { hidden = name }
        else if !hidden.isEmpty() && name == "/" + hidden { hidden = "" }
      pieces = pieces.push(" ")
      cursor = end + 1
    } else {
      if hidden.isEmpty() { pieces = pieces.push(character.toText()) }
      cursor = cursor + 1
    }
  }
  let text = pieces.join("").replace("&lt;", "<").replace("&gt;", ">").replace("&quot;", "\"").replace("&#39;", "'").replace("&amp;", "&")
  text.replace("\n", " ").replace("\t", " ").split(" ").filter(|word: Str| !word.isEmpty()).join(" ")
}
